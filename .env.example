# Variables d'environnement pour MesureChassis backend
# À configurer dans Railway → service backend → Variables

# MongoDB (URL fournie par le service MongoDB de Railway)
MONGO_URL=mongodb://user:pass@host:port/dbname
DB_NAME=mesurechassis

# Sécurité JWT (générer une chaîne aléatoire longue - ne JAMAIS commit la vraie valeur)
JWT_SECRET=changeme-generate-a-random-32-char-string-here
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Resend (envoi d'emails)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Emergent LLM Key (clé universelle pour OpenAI/Anthropic/Google)
EMERGENT_LLM_KEY=sk-emergent-xxxxxxxxx

# Port (Railway le fournit automatiquement, NE PAS définir manuellement)
# PORT=8001
