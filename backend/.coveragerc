[run]
source = .
branch = True
omit =
    tests/*
    seed_demo.py
    routes/__init__.py
    .venv/*
    */site-packages/*

[report]
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
precision = 1
show_missing = True
skip_covered = False

[html]
directory = htmlcov
