{
  "expo": {
    "name": "Mesure escalier",
    "slug": "mesure-escalier",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mesureescalier",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mesurechassis.escalier",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Dicter les remarques terrain à voix haute",
        "NSCameraUsageDescription": "Scanner les marqueurs ArUco et photographier vos chantiers",
        "NSPhotoLibraryUsageDescription": "Joindre vos photos de chantier aux rapports",
        "NSPhotoLibraryAddUsageDescription": "Enregistrer les rapports et photos générés",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mesurechassis.escalier",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1A1E2A"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1A1E2A"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Dicter les remarques terrain à voix haute"
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "MesureEscalier scanne les marqueurs ArUco posés sur vos marches",
          "enableCodeScanner": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1",
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
